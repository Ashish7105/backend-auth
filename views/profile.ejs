<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white  p-10">
        <div class="w-full flex justify-end ">
            <a class="bg-red-500 rounded-md px-3 py-2" href="/logout">logout</a>

        </div>
        <h3 class="text-3xl mb-5 text-white py-2"> <span class="font-light"> Hello</span>, <%= user.name %>
        </h3>
        <h5 class="text-zinc-300  mb-1">you can create a new post.</h5>


        <!-- here the api is connected for post when the user will click on submit button   -->
        <form method="post" action="/post">
            <textarea placeholder="what's on your mind!?"
                class="w-1/3 block resize-none p-3 text-white bg-transparent border-2 border-zinc-800 outline-none rounded-md"
                name="content"></textarea>
            <input class="px-3 w-30 text-sm text-white py-2 bg-blue-400 rounded-md block mt-2" type="submit"
                value="Create new post">
        </form>

        <div class="posts mt-10">
            <h3 class="text-zinc-400">your posts. </h3>

            <!-- this is the post 1st container -->
            <div class="Postcontainer mt-3 ">

                <% user.posts.reverse().forEach(function(post) { %>
                    
                    <div class="post w-1/3 p-3 border-2 mb-2  rounded-md border-[1px] bg-zinc-800 border-zinc-500">
                        <h4 class="text-blue-500 mb-1"> @<%= user.name %>
                        </h4>
                        <p class="text-sm tracking-tight"><%= post.content %></p>

                        <div class="btn flex gap-3 mt-3">
                            <a class="text-blue-500" href="">Like</a>
                            <a class="text-zinc-500" href="">edit</a>
                        </div>

                    </div>

                    <% }) %>

            </div>


        </div>
    </div>
</body>

</html>