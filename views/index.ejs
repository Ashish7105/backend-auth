<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10">
        <h3 class="text-3xl text-white py-2"> create Account</h3>
        <form action="/register" method="post">
            <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-500 text-white"  type="text" placeholder="username" name="username">
            <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-500 text-white"  type="email" placeholder="email" name="email"> 
            <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-500 text-white"  type="number" placeholder="age" name="age">
            <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-500 text-white"  type="text" placeholder="name" name="name">
            <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-500 text-white"  type="password" placeholder="password" name="password">
            <input class="text-white bg-blue-500" type="submit" value="create Account">
        </form>
 
    </div>

    
</body>
</html>